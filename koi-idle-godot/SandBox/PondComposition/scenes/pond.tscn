script/source = "class_name DisplayFishComponent extends Node


@export var fish_res_array_to_display:Array 

var list_of_fish
#@onready var save_data = 
#this has number of fish, and the resources with the info


func _ready(): ### I might not need this
	var save_data = SaveManager.load_saved_data() 
	#save_data.list_of_shop_fish.append_array(list_of_shop_fish)
	list_of_fish = save_data.list_of_work_fish
	summon_fish(list_of_fish)
	#print(list_of_fish)
	#if fish_res_array_to_display:
		
	pass
	#return
	
func display_fish(fish_res_array_to_display):
	for fish in fish_res_array_to_display:
		summon_fish(fish)
	pass

func summon_fish(fish_list):
	for fish in fish_list:
		var fish_to_show = new_generate_fish(fish)
		add_child(fish_to_show)
	pass
	
	
	
func new_generate_fish(fish_res):
	var procedural_fish_scene = preload(\"res://game_parts/fish_gallery/scenes/procedural_fish.tscn\").instantiate()
	var line_body = procedural_fish_scene.get_node(\"body\")
	
	# Force duplicate the texture and its sub-resources BEFORE modifying
	if line_body.texture:
		line_body.texture = line_body.texture.duplicate(true)
		if line_body.texture.color_ramp:
			line_body.texture.color_ramp = line_body.texture.color_ramp.duplicate(true)
		if line_body.texture.noise:
			line_body.texture.noise = line_body.texture.noise.duplicate(true)
	
	var script = preload(\"res://game_parts/fish_gallery/scripts/procedural_body.gd\")
	var instance = script.new()
	line_body.add_child(instance)
	instance.modify_parent(fish_res)
	return procedural_fish_scene
	#viewport.add_child(procedural_fish_scene)
	#before the scene, that is now ready to go would be added to the viewport,
	#but in this case, I just want to return the fish to be added.
"

