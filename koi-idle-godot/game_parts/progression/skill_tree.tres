[gd_resource type="Resource" script_class="SkillTree" format=3]

[ext_resource type="Script" path="res://scripts/progression/skill_def.gd" id="1_def"]
[ext_resource type="Script" path="res://scripts/progression/skill_tree.gd" id="2_tree"]

[sub_resource type="Resource" id="Skill_rich_water"]
script = ExtResource("1_def")
id = "rich_water"
title = "Rich Water"
description = "Every fish earns a little more."
knob = "income"
mult_per_level = 1.05
max_level = 5
cost = 1
grid_pos = Vector2i(0, 0)

[sub_resource type="Resource" id="Skill_golden_scales"]
script = ExtResource("1_def")
id = "golden_scales"
title = "Golden Scales"
description = "Every fish earns a lot more."
knob = "income"
mult_per_level = 1.1
max_level = 3
cost = 2
requires = [SubResource("Skill_rich_water")]
grid_pos = Vector2i(0, 1)

[sub_resource type="Resource" id="Skill_big_appetite"]
script = ExtResource("1_def")
id = "big_appetite"
title = "Big Appetite"
description = "Pond fish grow bigger before they stop."
knob = "growth_potential"
mult_per_level = 1.1
max_level = 5
cost = 1
grid_pos = Vector2i(2, 0)

[sub_resource type="Resource" id="Skill_giant_genes"]
script = ExtResource("1_def")
id = "giant_genes"
title = "Giant Genes"
description = "Pond fish grow much bigger."
knob = "growth_potential"
mult_per_level = 1.25
max_level = 3
cost = 2
requires = [SubResource("Skill_big_appetite")]
grid_pos = Vector2i(2, 1)

[resource]
script = ExtResource("2_tree")
skills = [SubResource("Skill_rich_water"), SubResource("Skill_golden_scales"), SubResource("Skill_big_appetite"), SubResource("Skill_giant_genes")]
