[gd_resource type="Resource" script_class="SkillTree" format=3]

[ext_resource type="Script" path="res://scripts/progression/skill_def.gd" id="1_def"]
[ext_resource type="Script" path="res://scripts/progression/skill_tree.gd" id="2_tree"]

[sub_resource type="Resource" id="Skill_bowl"]
script = ExtResource("1_def")
id = "bigger_bowl"
title = "Bigger Bowl"
description = "More room in the toilet for working fish."
knob = "toilet_capacity"
extra_per_level = 5.0
max_level = 3
cost = 1
grid_pos = Vector2i(1, 0)

[sub_resource type="Resource" id="Skill_pool"]
script = ExtResource("1_def")
id = "wider_pool"
title = "Wider Pool"
description = "The shop offers more fish to pick from."
knob = "shop_pool"
extra_per_level = 5.0
max_level = 2
cost = 1
requires = [SubResource("Skill_bowl")]
grid_pos = Vector2i(0, 1)

[sub_resource type="Resource" id="Skill_recycler"]
script = ExtResource("1_def")
id = "recycler"
title = "Recycler"
description = "Recycling a shop fish keeps less of a fee back."
knob = "recycle_fee"
mult_per_level = 0.5
max_level = 2
cost = 1
requires = [SubResource("Skill_bowl")]
grid_pos = Vector2i(2, 1)

[sub_resource type="Resource" id="Skill_throne"]
script = ExtResource("1_def")
id = "grand_throne"
title = "Grand Throne"
description = "A toilet fit for a koi empire."
knob = "toilet_capacity"
extra_per_level = 10.0
max_level = 1
cost = 3
requires = [SubResource("Skill_pool"), SubResource("Skill_recycler")]
grid_pos = Vector2i(1, 2)

[resource]
script = ExtResource("2_tree")
skills = [SubResource("Skill_bowl"), SubResource("Skill_pool"), SubResource("Skill_recycler"), SubResource("Skill_throne")]
