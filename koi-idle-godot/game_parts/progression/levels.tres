[sub_resource type="Resource" id="Boss_6"]
script = ExtResource("3_boss")
boss_name = "The Dragon Gate"
weight_grams = 88000000.0
look_rank = 6
look_seed = 168
colors = PackedColorArray(0.8471, 0.1569, 0.1647, 1, 0.949, 0.7882, 0.298, 1, 0.102, 0.102, 0.102, 1)
size = 18.0
dialogue = PackedStringArray("So. A keeper reaches the falls.", "you: They say a koi that climbs this water becomes a dragon.", "They say many things. Most koi never try.", "You raised them, fed them, let them go, and came back every time.", "you: What's above the falls?", "Something new. Go and see.")

