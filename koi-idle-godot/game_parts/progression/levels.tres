[sub_resource type="Resource" id="Boss_2"]
script = ExtResource("3_boss")
boss_name = "Grandfather Carp"
weight_grams = 61000.0
look_rank = 3
look_seed = 42
colors = PackedColorArray(0.1686, 0.1686, 0.1686, 1, 0.8784, 0.6275, 0.1882, 1, 0.949, 0.9373, 0.8941, 1)
size = 14.0
dialogue = PackedStringArray("Ah. Another keeper climbs the ladder.", "you: Did others come before me?", "Many. Most stopped at the toilet. You did not.", "Fish grow slower in sacred water. Be gentle with them.", "you: I will.", "Then go. The river is waiting.")

