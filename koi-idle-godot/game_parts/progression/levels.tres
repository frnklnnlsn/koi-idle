[sub_resource type="Resource" id="Boss_3"]
script = ExtResource("3_boss")
boss_name = "Mudmouth"
weight_grams = 240000.0
look_rank = 4
look_seed = 73
colors = PackedColorArray(0.3529, 0.2902, 0.1804, 1, 0.1216, 0.102, 0.0706, 1)
size = 15.0
dialogue = PackedStringArray("Blub. You found me under all that mud.", "you: Nobody can see anything down there.", "That's the point. Fish here cost more and hide better.", "you: Is it worth it?", "Ask me again when you're downstream. Blub.")

