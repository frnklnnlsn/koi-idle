[sub_resource type="Resource" id="Boss_5"]
script = ExtResource("3_boss")
boss_name = "Moonscale"
weight_grams = 7000000.0
look_rank = 5
look_seed = 133
colors = PackedColorArray(0.7843, 0.8392, 1.0, 1, 0.1059, 0.1647, 0.3608, 1, 1.0, 1.0, 1.0, 1)
size = 17.0
dialogue = PackedStringArray("Shh. The tide is listening.", "you: You glow like the moon.", "I am what's left of every fish that tried the waterfall and fell.", "you: The waterfall?", "The Dragon Gate. Only one more water stands before it.", "Go. Climb.")

