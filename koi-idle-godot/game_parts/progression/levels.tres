[sub_resource type="Resource" id="Boss_0"]
script = ExtResource("3_boss")
boss_name = "Old Whiskers"
weight_grams = 4200.0
look_rank = 2
look_seed = 11
colors = PackedColorArray(0.7882, 0.7647, 0.698, 1, 0.2275, 0.2078, 0.1882, 1)
size = 12.0
dialogue = PackedStringArray("...You pulled me out of my porcelain throne.", "you: You're the biggest fish I've ever seen.", "Big? I'm the oldest. Every koi in this bowl swims in my wake.", "you: What happens now?", "Now you go somewhere bigger. The water gets harder from here, little keeper.", "Take what you've learned. Leave the money. It never swims far anyway.")

[sub_resource type="Resource" id="Level_0"]
script = ExtResource("2_level")
title = "The Bathroom"
boss_mass = 1000.0
boss = SubResource("Boss_0")

[sub_resource type="Resource" id="Knob_1_0"]
script = ExtResource("4_knob")
knob = "bite_time"
multiplier = 1.25

[sub_resource type="Resource" id="Boss_1"]
script = ExtResource("3_boss")
boss_name = "The Porcelain Queen"
weight_grams = 18000.0
look_rank = 3
look_seed = 27
colors = PackedColorArray(1.0, 1.0, 1.0, 1, 0.8471, 0.1569, 0.1647, 1)
size = 13.0
dialogue = PackedStringArray("How rude. I was in the middle of a nap.", "you: You're... beautiful.", "Of course I am. Red on white, the oldest pattern there is.", "you: Will you teach me?", "Patience teaches. The bites come slower where you're going.", "Off you go. Mind the herons.")

[sub_resource type="Resource" id="Level_1"]
script = ExtResource("2_level")
title = "The Garden Pond"
knob_changes = Array[ExtResource("4_knob")]([SubResource("Knob_1_0")])
boss_mass = 5000.0
boss = SubResource("Boss_1")

