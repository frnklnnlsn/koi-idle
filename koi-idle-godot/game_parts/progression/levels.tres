[sub_resource type="Resource" id="Boss_4"]
script = ExtResource("3_boss")
boss_name = "The Gilded One"
weight_grams = 1300000.0
look_rank = 5
look_seed = 101
colors = PackedColorArray(0.949, 0.7882, 0.298, 1, 0.7216, 0.5255, 0.0431, 1, 1.0, 0.9529, 0.7686, 1)
size = 16.0
dialogue = PackedStringArray("Every scale of mine is worth more than your whole first pond.", "you: So why let me catch you?", "Let you? I was curious who keeps coming back.", "Gold is heavy, keeper. The lake will ask more of you.", "you: I'm ready.", "We'll see. Swim on.")

