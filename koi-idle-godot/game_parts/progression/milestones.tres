[gd_resource type="Resource" script_class="MilestoneList" format=3]

[ext_resource type="Script" path="res://scripts/progression/milestone_list.gd" id="1_list"]
[ext_resource type="Script" path="res://scripts/progression/milestone_def.gd" id="2_def"]

[sub_resource type="Resource" id="Resource_first_buy"]
script = ExtResource("2_def")
id = "first_buy"
title = "First rank %d fish bought"
kind = 0
rank = -1
points = 1
per_level = true

[resource]
script = ExtResource("1_list")
milestones = Array[ExtResource("2_def")]([SubResource("Resource_first_buy")])
