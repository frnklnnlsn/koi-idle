; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="koi idle godot"
run/main_scene="res://game_parts/user_interface/scenes/main_UI.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://art/icon.svg"

[autoload]

FishGenerator="*res://scripts/Singletons/FishGenerator.gd"
SaveManager="*res://scripts/Singletons/SaveManager.gd"
FishHandler="*res://scripts/Singletons/FishHandler.gd"
DisplayManager="*res://scripts/Singletons/DisplayManager.gd"
FishGrowthManager="*res://scripts/Singletons/FishGrowthManager.gd"
PassiveSystems="*res://scripts/Singletons/PassiveSystems.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/initial_position_type=0
window/size/always_on_top=true
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/kanban_tasks/plugin.cfg")

[file_customization]

folder_colors={
"res://SandBox/": "yellow",
"res://addons/": "gray",
"res://art/": "red",
"res://assets/": "gray",
"res://game_parts/": "blue"
}

[rendering]

textures/canvas_textures/default_texture_filter=0
